{
  "name": "@ssccsorg/skene-frame",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Universal control surface for FIH state chains: a single open layer where every fact, intent, and hint is made visible, verifiable, and controllable, beneath your products and adapted to any domain through modular packs.",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./tokens.css": "./tokens.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": [
      "./src/lib/*.ts",
      "./src/lib/*.tsx"
    ],
    "./stores/*": "./src/stores/*.ts",
    "./views/*": [
      "./src/views/*.ts",
      "./src/views/*.tsx"
    ],
    "./tools/*": "./tools/*",
    "./lib/brand": "./src/lib/brand.tsx"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "@ssccsorg/skene-kernel": "0.1.0",
    "@ssccsorg/skene-ui": "0.1.0",
    "@xyflow/react": "^12.9.2",
    "dagre": "^0.8.5",
    "lucide-react": "^0.548.0",
    "markdown-it": "^15.0.2",
    "react-router-dom": "^7.9.5",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "agents",
    "control-surface",
    "fih",
    "frame",
    "intents",
    "react",
    "records",
    "visualisation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssccsorg/skene.git",
    "directory": "packages/frame"
  },
  "homepage": "https://github.com/ssccsorg/skene#readme",
  "bugs": {
    "url": "https://github.com/ssccsorg/skene/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "tokens.css",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  }
}
