{
  "name": "@ssccs/skene-frame",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The single space where every fact, intent and hint of an agentic system is drawn, read and commanded: the open surface beneath the products, with each domain's readings plugged in as a pack.",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./tokens.css": "./tokens.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./views/*": [
      "./src/views/*.ts",
      "./src/views/*.tsx"
    ]
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dagre": "^0.8.5",
    "lucide-react": "^0.548.0",
    "maplibre-gl": "^6.14.0",
    "markdown-it": "^15.0.2",
    "radix-ui": "^1.7.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "records",
    "agents",
    "frame",
    "tauri",
    "react",
    "visualisation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssccsorg/skene.git",
    "directory": "packages/frame"
  },
  "homepage": "https://github.com/ssccsorg/skene#readme",
  "bugs": {
    "url": "https://github.com/ssccsorg/skene/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "tokens.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
